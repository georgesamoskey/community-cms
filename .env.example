# URL du portail membre
NEXT_PUBLIC_PORTAL_URL=http://localhost:3003

# URL backoffice (optionnel, mention marketing)
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001

# API santé publique
NEXT_PUBLIC_EAGASEKE_ORIGIN=http://localhost:30009

# Auth.js — Keycloak (client oidc « cms »)
AUTH_SECRET=changez-moi-openssl-rand-base64-32
AUTH_KEYCLOAK_ISSUER=http://localhost:8099/realms/community-platform
AUTH_KEYCLOAK_ID=cms
AUTH_KEYCLOAK_SECRET=cms-dev-secret-change-me
AUTH_URL=http://localhost:3004
# AUTH_KEYCLOAK_SCOPE=openid profile email
# Rôles : cms_viewer (read) | cms_editor (draft) | cms_publisher (live) | admin

# Mot de passe local — seulement si Keycloak absent, ou CMS_ALLOW_PASSWORD_AUTH=true
CMS_EDITOR_PASSWORD=dev-cms-editor
# CMS_ALLOW_PASSWORD_AUTH=true

# Autoriser l'écriture du site builder en production
# CMS_ALLOW_WRITE=true

# Webhook après publication (optionnel)
# CMS_PUBLISH_WEBHOOK_URL=https://hooks.example.com/cms
# CMS_PUBLISH_WEBHOOK_SECRET=change-me

# Ingest eagaseke (POST /api/cms/ingest) — même secret côté API
# CMS_INGEST_SECRET=change-me-ingest-secret
# EAGASEKE_ORIGIN=http://localhost:3000

# i18n : locales configurées dans settings.i18n + localeOverlays (studio Marque)
